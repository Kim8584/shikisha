# Shikisha Environment Configuration
# Copy to .env and configure as needed

# Local EVM / Anvil RPC
RPC_URL=http://127.0.0.1:8545

# Deployer Private Key (default Anvil Key #0)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Chainlink CRE Authentication (Optional, required for live cre workflow simulate)
# Create key at https://app.chain.link (Account Settings)
CRE_API_KEY=

# Verifier & Receipt HTTP Services
PORT=8080
VERIFIER_URL=http://127.0.0.1:8080/verify
RECEIPT_URL=http://127.0.0.1:8080/receipt/1
